# Copy to backend/.env and run backend commands from backend/.
# Defaults below target services started with docker compose up --build.
# For an API running on the host, replace db and redis with localhost.
DATABASE_URL=postgresql://postgres:postgres@db:5432/auth_api
REDIS_HOST=redis
REDIS_PORT=6379
BROKER_URL=redis://redis:6379/0

# Generate a signing secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-generated-signing-secret
AUTH_STRATEGY=JWT
REFRESH_TOKENS_ENABLED=true
# Set true behind HTTPS in production to enable secure cookies.
is_production=false
CORS_ORIGINS=["http://localhost:3000"]
# Public backend URL used in verification, reset, and magic-link emails.
APP_BASE_URL=http://localhost:8000

# Resend credentials and a sender address on your verified domain.
RESEND_KEY=replace-with-your-resend-api-key
SENDER_EMAIL=AuthCore <auth@example.com>

# Register these callback URLs in your OAuth applications.
GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret
GOOGLE_CLIENT_URI=http://localhost:8000/auth/google/callback
GITHUB_CLIENT_ID=replace-with-your-github-client-id
GITHUB_SECRET=replace-with-your-github-client-secret
GITHUB_CLIENT_URI=http://localhost:8000/auth/github/callback

# Generate a Fernet key before enabling TOTP:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP=false
TOTP_SECRET=replace-with-a-generated-fernet-key
